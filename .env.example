# Agent-OS local config TEMPLATE. Copy to .env.local and fill in. .env.local is gitignored.
# NEVER put real secrets in .env.example (this file is committed).

# --- Step 2: ntfy phone bridge ---
NTFY_BASE_URL=http://localhost:8080
# Hard-to-guess base topic. You pick this; you also subscribe to it on the ntfy phone app.
# Notifications (agent -> phone) go to <TOPIC>. Your replies (phone -> agent) go to <TOPIC>-reply.
NTFY_TOPIC=CHANGE-ME-to-a-long-random-string

# --- Step 3: Postgres + pgvector (filled in Step 3) ---
# DATABASE_URL=postgresql://agentos:CHANGE-ME@127.0.0.1:5433/agentos

# --- Step 4: NATS (filled in Step 4) ---
# NATS_URL=nats://127.0.0.1:4222
