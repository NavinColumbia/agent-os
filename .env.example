# Agent-OS local config TEMPLATE. Copy to .env.local and fill in. .env.local is gitignored.
# NEVER put real secrets in .env.example (this file is committed). platform/rebuild.sh fills the
# essentials automatically on a fresh box; this file documents EVERY key so any machine/cloud knows
# exactly what to set. Cloud migration = change these endpoints (see platform/inventory.yaml).

# --- Phone bridge (ntfy) ---
NTFY_BASE_URL=http://localhost:8080
# Hard-to-guess base topic. You pick this; you also subscribe to it on the ntfy phone app.
# Notifications (agent -> phone) go to <TOPIC>. Your replies (phone -> agent) go to <TOPIC>-reply.
NTFY_TOPIC=CHANGE-ME-to-a-long-random-string

# --- Postgres (state of EVERYTHING: exec, audit, comms, memory, vault, blobs, skills) ---
# Local: 127.0.0.1:5433. Cloud: swap host -> RDS/Cloud SQL/Neon endpoint, everything follows.
DATABASE_URL=postgresql://agentos:CHANGE-ME@127.0.0.1:5433/agentos

# --- Message bus (NATS/JetStream) ---
NATS_URL=nats://127.0.0.1:4222

# --- Policy decision point (Cerbos) ---
CERBOS_URL=http://127.0.0.1:3592

# --- HTTP API + dashboard ---
AOS_API_TOKEN=CHANGE-ME-to-a-long-random-bearer-token

# --- Object store backend: 'postgres' (default) or 's3' in cloud ---
OBJSTORE_BACKEND=postgres
# OBJSTORE_S3_BUCKET=agent-os-objstore        # when OBJSTORE_BACKEND=s3

# --- Reach (Tailscale) ---
TS_HOSTNAME=nyaan

# --- Mac runner (iOS/macOS), optional — see docs/MAC-SETUP.md ---
# MAC_HOST=navinashok-macbook-air
# MAC_USER=navinashok

# --- Deferred / paid creative engines (set a key to flip these from needs_key -> ready) ---
# REPLICATE_API_TOKEN=        # image generation (anime/manga/SDXL/Flux)
# FAL_KEY=                    # image generation (alternative)
# SUNO_API_KEY=               # music / SFX generation
# ELEVENLABS_API_KEY=         # premium voiceover (piper is the free local default)
