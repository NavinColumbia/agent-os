FROM python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 65532 sandbox \
    && useradd --system --uid 65532 --gid sandbox --home-dir /nonexistent --shell /usr/sbin/nologin sandbox \
    && chmod 0555 /tmp \
    && find / -xdev -type f -perm /6000 -exec chmod a-s '{}' +

COPY --chown=root:root src/agent_os/entrypoints/sandbox_job.py /opt/agent-os/sandbox_job.py
RUN chmod 0555 /opt/agent-os/sandbox_job.py

# The trusted controller starts as root only to create/chown the ephemeral
# workspace, then launches every tenant command as UID/GID 65532 with no secrets.
ENTRYPOINT ["python", "-I", "/opt/agent-os/sandbox_job.py"]
