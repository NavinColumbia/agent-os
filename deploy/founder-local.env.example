# Generated by deploy/founder-local.sh init. This template has no usable secrets.
AOS_V2_POSTGRES_PASSWORD=CHANGE_ME_GENERATED
AOS_V2_DATABASE_RUNTIME_PASSWORD=CHANGE_ME_GENERATED_SEPARATELY
AOS_V2_AUTH_SECRET=CHANGE_ME_GENERATED
AOS_V2_CAPABILITY_SECRET=CHANGE_ME_GENERATED_SEPARATELY
AOS_V2_PUBLIC_PORT=8088
AOS_V2_POSTGRES_HOST_PORT=55432
AOS_V2_PUBLIC_BASE_URL=http://127.0.0.1:8088
AOS_V2_APPLICATION_VERSION=founder-local
AOS_V2_EXECUTION_CELL_ID=local
AOS_V2_IDENTITY_MODE=hmac
AOS_V2_BILLING_MODE=disabled
AOS_V2_TENANT_MONTHLY_MODEL_BUDGET_CENTS=10000
AOS_V2_PREVIEW_TTL_SECONDS=604800
AOS_V2_ARTIFACT_MAX_CONTENT_BYTES=16777216

# Uses the existing trusted local Codex/ChatGPT login. This mode is rejected
# for production, paid billing, or any non-loopback public URL.
AOS_V2_MODEL=codex-cli:default
AOS_V2_MODEL_REQUEST_TIMEOUT_SECONDS=900
AOS_V2_MODEL_REQUEST_LIMIT=12
AOS_V2_MODEL_OUTPUT_TOKENS_LIMIT=30000

AOS_V2_SANDBOX_BACKEND=docker
# The launcher replaces this bootstrap image with the immutable local ID of
# Dockerfile.sandbox-browser-local before starting the worker.
AOS_V2_SANDBOX_IMAGE=python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
AOS_V2_SANDBOX_TIMEOUT_SECONDS=300
AOS_V2_SANDBOX_MAX_OUTPUT_BYTES=8388608
AOS_V2_SANDBOX_WORKSPACE_LIMIT_BYTES=33554432
AOS_V2_SANDBOX_WORKSPACE_ROOT=/absolute/path/to/.runtime/founder-local/sandbox
AOS_V2_CONNECTOR_SECRET_DIR=/absolute/path/to/deploy/connector-secrets
