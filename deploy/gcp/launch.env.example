# Copy to .runtime/gcp-launch.env, chmod 600, and replace every CHANGE_ME.
# This is a shell environment file consumed only by deploy-from-env.sh.

GCP_PROJECT_ID=CHANGE_ME-control-project
GCP_SANDBOX_PROJECT_ID=CHANGE_ME-sandbox-project
GCP_APP_PROJECT_ID=CHANGE_ME-generated-app-project
GCP_REGION=us-central1
GCP_STATE_BUCKET=CHANGE_ME-control-project-agentos-tofu-state
# Existing Cloud DNS managed-zone name, or leave empty for external DNS.
GCP_DNS_MANAGED_ZONE=

AOS_V2_PUBLIC_BASE_URL=https://agent.CHANGE_ME.example
AOS_V2_APPS_BASE_URL=https://apps.CHANGE_ME.example

# Auth0-style public OAuth/OIDC API + SPA (authorization code with PKCE).
AOS_V2_OIDC_ISSUER=https://CHANGE_ME.us.auth0.com/
AOS_V2_OIDC_AUDIENCE=https://agent-os-api.CHANGE_ME.example
AOS_V2_OIDC_JWKS_URL=https://CHANGE_ME.us.auth0.com/.well-known/jwks.json
AOS_V2_OIDC_AUTHORIZATION_URL=https://CHANGE_ME.us.auth0.com/authorize
AOS_V2_OIDC_TOKEN_URL=https://CHANGE_ME.us.auth0.com/oauth/token
AOS_V2_OIDC_CLIENT_ID=CHANGE_ME
AOS_V2_OIDC_SCOPE='openid profile email'
AOS_V2_OIDC_AUTHORIZATION_AUDIENCE_PARAMETER=audience

AOS_V2_STRIPE_STARTER_PRICE_ID=price_CHANGE_ME
AOS_V2_STRIPE_GROWTH_PRICE_ID=price_CHANGE_ME
AOS_V2_STRIPE_SECRET_KEY=sk_live_CHANGE_ME
AOS_V2_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# The migration login owns tables. Both runtime URLs use the separate constrained login below.
AOS_V2_MIGRATION_DATABASE_URL='postgresql://migration_owner:CHANGE_ME@CHANGE_ME/agentos?sslmode=require'
AOS_V2_DATABASE_RUNTIME_ROLE=agentos_runtime
AOS_V2_SYSTEM_DATABASE_URL='postgresql://agentos_runtime:CHANGE_ME@CHANGE_ME/agentos?sslmode=require'
AOS_V2_APPLICATION_DATABASE_URL='postgresql://agentos_runtime:CHANGE_ME@CHANGE_ME/agentos?sslmode=require'

AOS_V2_MODEL=openai:gpt-5-mini
AOS_V2_MODEL_PROVIDER_SECRET_ENVIRONMENT=OPENAI_API_KEY
AOS_V2_MODEL_PROVIDER_KEY=sk-proj-CHANGE_ME

# At least one already-tested Cloud Monitoring destination.
AOS_ALERT_NOTIFICATION_CHANNELS='["projects/CHANGE_ME/notificationChannels/CHANGE_ME"]'
