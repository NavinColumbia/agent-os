# Generated automatically by deploy/local-pilot.sh init.
# This documented template contains no usable credential.
AOS_V2_POSTGRES_PASSWORD=CHANGE_ME_GENERATED
AOS_V2_DATABASE_RUNTIME_PASSWORD=CHANGE_ME_GENERATED_SEPARATELY
AOS_V2_AUTH_SECRET=CHANGE_ME_GENERATED
AOS_V2_CAPABILITY_SECRET=CHANGE_ME_GENERATED_SEPARATELY
AOS_V2_PUBLIC_PORT=8088
AOS_V2_PUBLIC_BASE_URL=https://machine.tailnet.ts.net:10000
AOS_V2_APPLICATION_VERSION=local-pilot
AOS_V2_IDENTITY_MODE=hmac
AOS_V2_BILLING_MODE=disabled
AOS_V2_TENANT_MONTHLY_MODEL_BUDGET_CENTS=10000
AOS_V2_PREVIEW_TTL_SECONDS=604800

# The recommended zero-charge pilot model. Free-tier prompts may be used by
# Google to improve its products, so do not accept confidential customer data.
AOS_V2_MODEL=google:gemini-3.8-flash
GEMINI_API_KEY=CHANGE_ME_FREE_AUTH_KEY
GOOGLE_API_KEY=

AOS_V2_SANDBOX_BACKEND=docker
AOS_V2_SANDBOX_IMAGE=python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
AOS_V2_SANDBOX_TIMEOUT_SECONDS=300
AOS_V2_SANDBOX_WORKSPACE_ROOT=/absolute/path/to/.runtime/local-pilot/sandbox

# Generated from the local WSL/Docker identities so sandbox files remain
# accessible without running the worker as root.
AOS_PILOT_UID=1000
AOS_PILOT_GID=1000
AOS_PILOT_DOCKER_GID=989
