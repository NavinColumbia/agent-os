# Agent OS public-host template. Copy to ../.env.local, then replace the public-launch placeholders.
# platform/rebuild.sh generates the local database password and cryptographic secrets without overwriting
# credentials you provide here.

# Local private dependencies (kept off the public network).
DATABASE_URL=postgresql://agentos:CHANGE-ME@127.0.0.1:5433/agentos
NATS_URL=nats://127.0.0.1:4222
CERBOS_URL=http://127.0.0.1:3592
NTFY_BASE_URL=http://127.0.0.1:8080
NTFY_TOPIC=CHANGE-ME-generated-during-rebuild
AOS_API_TOKEN=CHANGE-ME-generated-during-rebuild
AUDIT_HMAC_KEY=CHANGE-ME-generated-during-rebuild
VAULT_KEY=CHANGE-ME-generated-during-rebuild

# Public DNS/TLS origin.
AOS_PUBLIC_HOST=agents.example.com
AOS_PUBLIC_URL=https://agents.example.com

# Transactional verification/reset mail. Configure SMTP OR uncomment/configure SendGrid.
AOS_SMTP_URL=CHANGE-ME-to-an-smtps-or-starttls-URL
# SENDGRID_API_KEY=CHANGE-ME-to-a-SendGrid-key
# Use a monitored human sender for paid-pilot outreach/replies; transactional mail may use the same address.
AOS_SMTP_FROM=swami@example.com

# Stripe live billing and same-origin checkout return URLs.
STRIPE_SECRET_KEY=CHANGE-ME-to-sk_live
STRIPE_WEBHOOK_SECRET=CHANGE-ME-to-whsec
AOS_STRIPE_PRICE_PRO=CHANGE-ME-to-price-id
AOS_STRIPE_PRICE_ENTERPRISE=CHANGE-ME-to-price-id
AOS_STRIPE_SUCCESS_URL=https://agents.example.com/#billing
AOS_STRIPE_CANCEL_URL=https://agents.example.com/#billing
# Optional founding Release Assurance checkout. Create a $500 Stripe Payment Link.
# The intake accepts only an HTTPS buy.stripe.com URL and otherwise falls back to email follow-up.
# AOS_ASSURANCE_PAYMENT_URL=https://buy.stripe.com/CHANGE-ME

# Encrypted daily backup. Keep this passphrase separately and mount an actually off-host destination.
AOSNAP_PASS=CHANGE-ME-generated-during-rebuild
AOSNAP_OFFSITE_DIR=CHANGE-ME-to-a-mounted-off-host-directory

# Optional platform-wide model providers. Tenants can instead connect their own provider during onboarding.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
