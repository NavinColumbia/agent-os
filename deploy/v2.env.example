# Evaluation/BYOC Compose settings. Do not commit real values.
AOS_V2_POSTGRES_PASSWORD=replace-with-a-long-random-password
AOS_V2_DATABASE_RUNTIME_PASSWORD=replace-with-a-different-long-random-password
AOS_V2_IDENTITY_MODE=hmac
AOS_V2_AUTH_SECRET=replace-with-at-least-32-random-bytes
AOS_V2_CAPABILITY_SECRET=replace-with-a-different-32-byte-random-secret
# Public production requires identity mode oidc plus all three values below.
# Configure the provider to issue org_id and roles claims, or override their names.
# AOS_V2_IDENTITY_MODE=oidc
# AOS_V2_OIDC_ISSUER=https://identity.example.com
# AOS_V2_OIDC_AUDIENCE=agent-os-api
# AOS_V2_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AOS_V2_OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
# AOS_V2_OIDC_TOKEN_URL=https://identity.example.com/oauth/token
# AOS_V2_OIDC_CLIENT_ID=your-public-spa-client-id
# AOS_V2_OIDC_SCOPE=openid profile email
# Set to audience or resource only when your provider requires that authorization parameter.
# AOS_V2_OIDC_AUTHORIZATION_AUDIENCE_PARAMETER=
# AOS_V2_OIDC_ORGANIZATION_CLAIM=org_id
# AOS_V2_OIDC_ROLES_CLAIM=roles
# AOS_V2_OIDC_ALGORITHMS=RS256,ES256
AOS_V2_APPLICATION_VERSION=v2-local
AOS_V2_PUBLIC_PORT=8080
AOS_V2_PUBLIC_BASE_URL=http://localhost:8080
# Optional standards-based background Web Push. Generate one VAPID pair;
# public/private must match. The private key belongs only in worker secrets.
# AOS_V2_WEB_PUSH_PUBLIC_KEY=
# AOS_V2_WEB_PUSH_PRIVATE_KEY=
# AOS_V2_WEB_PUSH_SUBJECT=mailto:push-operations@example.com
AOS_V2_PREVIEW_TTL_SECONDS=604800
# GCS artifact bytes expire after this period; immutable SQL metadata remains
# so release history is auditable without claiming the payload still exists.
AOS_V2_ARTIFACT_RETENTION_DAYS=365
# Optional vendor-neutral OTLP/HTTP trace export. Keep blank for an offline pilot.
# Remote staging/production endpoints must use HTTPS; a localhost collector may use HTTP.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional exporter authentication, for example `Authorization=Bearer ...`.
OTEL_EXPORTER_OTLP_HEADERS=
AOS_V2_OTLP_TRACE_SAMPLE_RATIO=0.1
# Conservative bootstrap ceiling per tenant; reservations happen before model calls.
AOS_V2_TENANT_MONTHLY_MODEL_BUDGET_CENTS=10000
# Keep disabled for local evaluation. Public production fails closed unless
# Stripe subscription truth is configured from signed webhooks.
AOS_V2_BILLING_MODE=disabled
# AOS_V2_BILLING_MODE=stripe
# AOS_V2_STRIPE_SECRET_KEY=sk_test_replace_me
# AOS_V2_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# AOS_V2_STRIPE_STARTER_PRICE_ID=price_replace_me
# AOS_V2_STRIPE_GROWTH_PRICE_ID=price_replace_me
# AOS_V2_STRIPE_STARTER_MODEL_BUDGET_CENTS=50000
# AOS_V2_STRIPE_GROWTH_MODEL_BUDGET_CENTS=250000
# AOS_V2_STRIPE_API_VERSION=2025-06-30.basil

# PydanticAI provider:model identifier and optional static tenant assignment.
AOS_V2_MODEL=replace-with-provider:model
# Leave blank for database-backed ready-tenant discovery. Set comma-separated
# tenant IDs only when intentionally pinning a worker to a BYOC/cell allowlist.
AOS_V2_WORKER_ORGANIZATIONS=
AOS_V2_TENANT_DISCOVERY_LIMIT=128
AOS_V2_MAX_TURN_COST_CENTS=100
AOS_V2_MODEL_REQUEST_TIMEOUT_SECONDS=120
AOS_V2_SANDBOX_BACKEND=disabled
# Dedicated local/CI runner hosts may set docker. Never mount a raw Docker
# socket into the public API or general agent-worker container.
# AOS_V2_SANDBOX_BACKEND=docker
# AOS_V2_SANDBOX_TIMEOUT_SECONDS=300
# AOS_V2_SANDBOX_IMAGE=python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
# AOS_V2_MANAGEMENT_CHECK_SECONDS=30
# AOS_V2_SLOW_WORK_SECONDS=300
# AOS_V2_MANAGEMENT_ESCALATION_CHECKS=3
# AOS_V2_MANAGER_TURN_COST_CENTS=25

# Optional connector credentials are files below:
#   <host-dir>/<sha256(tenant-id)>/<credential_ref>
# They are mounted read-only and never stored in PostgreSQL or artifacts.
AOS_V2_CONNECTOR_SECRET_HOST_DIR=./connector-secrets

# Set only the provider credential selected above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY takes precedence over GEMINI_API_KEY when both are set.
GOOGLE_API_KEY=
